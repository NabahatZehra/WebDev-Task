<!-- Header Partial -->
<%- include('partials/header', { title: "Home" }) %>

<main class="mainBox">

    <div class="box1">
        <div class="slide_active"
            style="background-image: url('/images/home_records_slide1_bg.jpg');">
            <div class="text-content">
                <h1>SOUNDS <span class="themecolor">GREAT</span><br>ON EVERY SPEAKERS</h1>
                <p>Trust our techniques and knowledge<br>in mixing and mastering</p>
            </div>
            <a class="see-more" href="http://themes.muffingroup.com/be/records/studio/" target="_blank">
                <img src="/images/home_record_button_see_more_orange.png" alt="See More" />
            </a>
        </div>

        <div class="slide"
            style="background-image: url('/images/home_records_slide2_bg.jpg');">
            <div class="text-content">
                <h1>THIS IS WHEN <br><span class="themecolor">ART</span> MEET <span
                        class="themecolor">TECHNOLOGY</span></h1>
            </div>
            <a class="see-more" href="http://themes.muffingroup.com/be/records/studio/" target="_blank">
                <img src="/images/home_record_button_see_more_orange.png" alt="See More" />
            </a>
        </div>
    </div>

    <div class="box2">
        <h2>OUR SERVICES</h2>

        <div class="box2_card">
            <div class="card">
                <img src="/images/home_record_icon_1.png" alt="icon1">
                <h3>Complex Recording</h3>
                <p>Vitae adipiscing turpis. Aenean ligula nibh, molestie id viverra a, dapibus at dolor.</p>
            </div>
            <div class="card">
                <img src="/images/home_record_icon_2.png" alt="icon2">
                <h3>Mixing & Mastering</h3>
                <p>In iaculis viverra neque, ac eleifend ante lobortis.</p>
            </div>
            <div class="card">
                <img src="/images/home_record_icon_3.png" alt="icon3">
                <h3>Productions</h3>
                <p>Molestie Aenean ligula nibh, molestie id viverra a, dapibus at dolor.</p>
            </div>
            <div class="card">
                <img src="/images/home_record_icon_4.png" alt="icon4">
                <h3>Industries</h3>
                <p>In iaculis viverra neque, ac eleifend ante lobortis.</p>
            </div>
        </div>
    </div>

    <div class="box3">
        <div class="box3-container">
            <div class="box3_background"></div>

            <div class="gallery">
                <div class="item"> <img src="/images/home_records_gallery6-300x300.jpg" alt="Speaker"> </div>
                <div class="item"> <img src="/images/home_records_gallery5-300x300.jpg" alt="MusicRoom"> </div>
                <div class="item"> <img src="/images/home_records_gallery4-300x300.jpg" alt="Amplifer"> </div>
                <div class="item"> <img src="/images/home_records_gallery3-300x300.jpg" alt="Mixing"> </div>
                <div class="item"> <img src="/images/home_records_gallery2-300x300.jpg" alt="Studio"> </div>
                <div class="item"> <img src="/images/home_records_gallery1-300x300.jpg" alt="Mic"> </div>
            </div>

            <div class="prepare">
                <h2>HOW TO PREPARE <br> FOR RECORDING</h2>
                <ul>
                    <li>Suspendisse a pellentesque dui, non felis</li>
                    <li>Quisque lorem tortor</li>
                    <li>Quisque cursus et porttitor</li>
                    <li>Nulla ipsum dolor lacus, suscipit adipiscing</li>
                    <li>Quisque lorem tortor fringilla</li>
                    <li>Vestibulum laoreet mi consequat eget dui non felis</li>
                    <li>Lorem tortor fringilla sed</li>
                    <li>Quisque cursus et, porttitor risus.</li>
                    <li>Nulla ipsum dolor lacus, suscipit adipiscing.</li>
                    <li>Fringilla sed suscipit</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="box4">
        <h2>OUR REALIZATIONS</h2>

        <div class="box4-container">
            <div class="box4-card">
                <img src="/images/home_records_realisation5.jpg" alt="Born and Raised">
                <div class="box4-info">
                    <h3>Born and Raised</h3>
                    <p>Mix and mastering</p>
                </div>
            </div>

            <div class="box4-card">
                <img src="/images/home_records_realisation4.jpg" alt="Farenheit">
                <div class="box4-info">
                    <h3>Farenheit</h3>
                    <p>Mix and mastering</p>
                </div>
            </div>

            <div class="box4-card">
                <img src="/images/home_records_realisation1.jpg" alt="Little Mix">
                <div class="box4-info">
                    <h3>Little Mix</h3>
                    <p>Recording</p>
                </div>
            </div>

            <div class="box4-card">
                <img src="/images/home_records_realisation3.jpg" alt="Lenny Williams">
                <div class="box4-info">
                    <h3>Lenny Williams</h3>
                    <p>Vocal recording</p>
                </div>
            </div>
        </div>

        <div class="see-more">
            <a href="clients"><img src="/images/home_record_button_see_more.png" alt="See More"></a>
        </div>
    </div>

    <section class="testimonials-section">
        <h2 class="heading">Customer <span class="heading-yellow">Testimonials</span></h2>

        <div class="testimonials">

            <% testimonials.forEach((t, index) => { %>
                <div class="testimonial <%= index >= 2 ? 'hidden' : '' %>">
                    <img src="/images/<%= t.image %>" class="profile-img" />
                    <div class="testimonial-content">
                        <h4 class="customer-name"><%= t.name %></h4>
                        <div class="stars"><%= t.stars %></div>
                        <p class="review-text"><%= t.review %></p>
                    </div>
                </div>
            <% }) %>

        </div>

        <button class="view-more-btn" id="viewMoreBtn">View More</button>
    </section>

</main>

<!-- Footer Partial -->
<%- include('partials/footer') %>

<script>
    const viewMoreBtn = document.getElementById("viewMoreBtn");
    const hiddenTestimonials = document.querySelectorAll(".testimonial.hidden");

    viewMoreBtn.addEventListener("click", () => {
        hiddenTestimonials.forEach(t => t.classList.toggle("hidden"));
        viewMoreBtn.textContent =
            viewMoreBtn.textContent === "View More" ? "View Less" : "View More";
    });
</script>
