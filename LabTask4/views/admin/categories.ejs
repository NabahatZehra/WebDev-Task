<%- include('partials/header') %>

<div class="page-header">
    <h2>📁 Manage Categories</h2>
</div>

<style>
    .categories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .category-card {
        background: #1a1c1c;
        border: 2px solid #333;
        border-radius: 10px;
        padding: 25px;
        transition: all 0.3s;
        border-left: 4px solid #f9a825;
    }

    .category-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 20px rgba(249, 168, 37, 0.3);
        border-color: #f9a825;
    }

    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .category-name {
        font-size: 20px;
        font-weight: 700;
        color: white;
    }

    .category-icon {
        font-size: 32px;
    }

    .category-count {
        font-size: 36px;
        font-weight: 700;
        color: #f9a825;
        margin-bottom: 10px;
    }

    .category-label {
        color: #888;
        font-size: 14px;
    }

    .category-actions {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #333;
    }

    .btn-view-products {
        background: #007bff;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
        width: 100%;
        text-align: center;
    }

    .btn-view-products:hover {
        background: #0056b3;
    }

    .info-box {
        background: rgba(249, 168, 37, 0.1);
        border: 2px solid #f9a825;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 30px;
    }

    .info-box h3 {
        color: #f9a825;
        margin-bottom: 10px;
        font-size: 18px;
    }

    .info-box p {
        color: #ccc;
        font-size: 14px;
        line-height: 1.6;
        margin: 0;
    }

    .stats-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 30px;
    }

    .stat-box {
        background: #1a1c1c;
        border: 2px solid #333;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
    }

    .stat-box .label {
        color: #888;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .stat-box .value {
        color: #f9a825;
        font-size: 32px;
        font-weight: 700;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #888;
    }

    .empty-state h3 {
        font-size: 24px;
        margin-bottom: 10px;
    }
</style>

<% if (success) { %>
    <div class="alert alert-success">
        ✓ <%= success %>
    </div>
<% } %>

<% if (error) { %>
    <div class="alert alert-error">
        ✗ <%= error %>
    </div>
<% } %>

<div class="info-box">
    <h3>📌 About Categories</h3>
    <p>Categories are automatically managed based on your products. The available categories are: Recording, Mixing, Mastering, Production, Equipment, and Services. When you add a product with a specific category, it will appear here.</p>
</div>

<div class="stats-summary">
    <div class="stat-box">
        <div class="label">Total Categories</div>
        <div class="value"><%= categories.length %></div>
    </div>
    <div class="stat-box">
        <div class="label">Total Products</div>
        <div class="value"><%= categories.reduce((sum, cat) => sum + cat.count, 0) %></div>
    </div>
</div>

<% if (categories.length > 0) { %>
    <div class="categories-grid">
        <% 
        const categoryIcons = {
            'Recording': '🎙️',
            'Mixing': '🎚️',
            'Mastering': '🎛️',
            'Production': '🎵',
            'Equipment': '🎸',
            'Services': '⭐'
        };
        %>
        <% categories.forEach(cat => { %>
            <div class="category-card">
                <div class="category-header">
                    <div class="category-name"><%= cat._id %></div>
                    <div class="category-icon"><%= categoryIcons[cat._id] || '📦' %></div>
                </div>
                <div class="category-count"><%= cat.count %></div>
                <div class="category-label">Products in this category</div>
                <div class="category-actions">
                    <a href="/admin/products?category=<%= cat._id %>" class="btn-view-products">
                        View Products →
                    </a>
                </div>
            </div>
        <% }) %>
    </div>
<% } else { %>
    <div class="empty-state">
        <h3>📁 No Categories Yet</h3>
        <p>Categories will appear automatically when you add products</p>
        <% if (isSuperAdmin) { %>
            <p style="margin-top: 20px;">
                <a href="/admin/products/add" style="color: #f9a825; text-decoration: underline;">Add your first product</a>
            </p>
        <% } else { %>
            <p style="margin-top: 20px; color: #aaa;">
                Read-only mode (Super Admin required to add products)
            </p>
        <% } %>
    </div>
<% } %>

<%- include('partials/footer') %>