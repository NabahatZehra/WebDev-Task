<%- include('partials/header') %>

<div class="page-header">
    <h2>📦 Manage Products</h2>
</div>

<style>
    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .btn-add {
        background: #28a745;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
    }

    .btn-add:hover {
        background: #218838;
        transform: translateY(-2px);
    }

    .products-table {
        background: #1a1c1c;
        border: 2px solid #333;
        border-radius: 10px;
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: rgba(249, 168, 37, 0.1);
    }

    th {
        padding: 15px;
        text-align: left;
        color: #f9a825;
        font-weight: 700;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: 2px solid #333;
    }

    td {
        padding: 15px;
        border-bottom: 1px solid #333;
        color: white;
    }

    tr:hover td {
        background: rgba(249, 168, 37, 0.05);
    }

    tr:last-child td {
        border-bottom: none;
    }

    .product-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 5px;
        border: 2px solid #f9a825;
    }

    .product-name {
        font-weight: 600;
        color: white;
    }

    .product-category {
        background: rgba(249, 168, 37, 0.2);
        color: #f9a825;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
        display: inline-block;
    }

    .product-price {
        font-weight: 700;
        color: #f9a825;
        font-size: 16px;
    }

    .product-stock {
        font-weight: 600;
    }

    .stock-low {
        color: #dc3545;
    }

    .stock-good {
        color: #28a745;
    }

    .featured-badge {
        background: #ffc107;
        color: #0f1111;
        padding: 3px 8px;
        border-radius: 3px;
        font-size: 11px;
        font-weight: bold;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
    }

    .btn-edit {
        background: #007bff;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
    }

    .btn-edit:hover {
        background: #0056b3;
    }

    .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-delete:hover {
        background: #c82333;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 30px;
    }

    .pagination a,
    .pagination span {
        padding: 8px 15px;
        background: #1a1c1c;
        border: 2px solid #333;
        border-radius: 5px;
        color: white;
        text-decoration: none;
        transition: all 0.3s;
    }

    .pagination a:hover {
        border-color: #f9a825;
        color: #f9a825;
    }

    .pagination .active {
        background: #f9a825;
        color: #0f1111;
        border-color: #f9a825;
        font-weight: bold;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #888;
    }

    .empty-state h3 {
        font-size: 24px;
        margin-bottom: 10px;
    }

    @media (max-width: 768px) {
        table {
            font-size: 12px;
        }

        th, td {
            padding: 10px;
        }

        .product-img {
            width: 40px;
            height: 40px;
        }
    }
</style>

<% if (success) { %>
    <div class="alert alert-success">
        ✓ <%= success %>
    </div>
<% } %>

<% if (error) { %>
    <div class="alert alert-error">
        ✗ <%= error %>
    </div>
<% } %>

<div class="action-bar">
    <% if (isSuperAdmin) { %>
        <a href="/admin/products/add" class="btn-add">+ Add New Product</a>
    <% } else { %>
        <div style="color: #aaa; font-size: 14px;">
            Read-only mode (Super Admin required for create/edit/delete)
        </div>
    <% } %>
    <div style="color: #888; font-size: 14px;">Total: <%= products.length %> products on this page</div>
</div>

<div class="products-table">
    <% if (products.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(product => { %>
                    <tr>
                        <td>
                            <img src="<%= product.image %>" alt="<%= product.name %>" class="product-img">
                        </td>
                        <td>
                            <div class="product-name"><%= product.name %></div>
                        </td>
                        <td>
                            <span class="product-category"><%= product.category %></span>
                        </td>
                        <td>
                            <span class="product-price">$<%= product.price %></span>
                        </td>
                        <td>
                            <span class="<%= product.stock > 5 ? 'stock-good' : 'stock-low' %>">
                                <%= product.stock %>
                            </span>
                        </td>
                        <td>
                            <% if (product.featured) { %>
                                <span class="featured-badge">★ Featured</span>
                            <% } %>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <% if (isSuperAdmin) { %>
                                    <a href="/admin/products/edit/<%= product._id %>" class="btn-edit">Edit</a>
                                    <form action="/admin/products/delete/<%= product._id %>" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this product?')">
                                        <button type="submit" class="btn-delete">Delete</button>
                                    </form>
                                <% } else { %>
                                    <a href="/products/<%= product._id %>" class="btn-edit" target="_blank" rel="noopener">View</a>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state">
            <h3>📦 No Products Yet</h3>
            <p>Start by adding your first product</p>
        </div>
    <% } %>
</div>

<% if (totalPages > 1) { %>
    <div class="pagination">
        <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>">← Previous</a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
                <span class="active"><%= i %></span>
            <% } else { %>
                <a href="?page=<%= i %>"><%= i %></a>
            <% } %>
        <% } %>

        <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>">Next →</a>
        <% } %>
    </div>
<% } %>

<%- include('partials/footer') %>