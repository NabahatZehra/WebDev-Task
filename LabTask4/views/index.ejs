    <section class="testimonials-section">
        <h2 class="heading">Customer<span class="heading-yellow">Testimonials</span></h2>

        <div class="testimonials">
            <% 
            const testimonialsData = testimonials || [
                { name: 'Muhammad Hussain', stars: '⭐⭐⭐⭐⭐', review: 'The sound quality of these speakers is unreal, crystal clear highs and deep, rich bass. Perfect for my home studio!', image: 'images.png' },
