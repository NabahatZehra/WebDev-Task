            ];
            
            testimonialsData.forEach((t, index) => { 
            %>
                <div class="testimonial <%= index >= 2 ? 'hidden' : '' %>">
                    <img src="/images/<%= t.images %>" alt="Profile <%= index + 1 %>" class="profile-img">
                    <div class="testimonial-content">
                        <h4 class="customer-name"><%= t.name %></h4>
                        <div class="stars"><%= t.stars %></div>
                        <p class="review-text"><%= t.review %></p>
