<%- include('partials/header') %>

    <style>
        body {
            background: linear-gradient(135deg, #0f1111 0%, #1a1c1c 100%);
        }

        .dashboard-container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 25px;
            background: rgba(26, 28, 28, 0.95);
            border-radius: 10px;
            border: 2px solid #f9a825;
            box-shadow: 0 10px 30px rgba(249, 168, 37, 0.25);
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .dashboard-header h2 {
            font-size: 24px;
            color: #f9a825;
        }

        .dashboard-header span {
            color: #ccc;
            font-size: 14px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 18px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: #151717;
            border-radius: 10px;
            padding: 18px 18px 16px;
            border: 1px solid #333;
            position: relative;
            overflow: hidden;
        }

        .stat-label {
            font-size: 13px;
            color: #aaa;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 26px;
            font-weight: 700;
            color: #f9a825;
        }

        .section-label {
            font-size: 11px;
            padding: 4px 9px;
            border-radius: 20px;
            background: rgba(249, 168, 37, 0.15);
            color: #f9f9f9;
            position: absolute;
            top: 14px;
            right: 14px;
        }

        .sections-grid {
            display: grid;
            grid-template-columns: 2fr 1.4fr;
            gap: 18px;
        }

        .section {
            background: #151717;
            padding: 18px;
            border-radius: 10px;
            border: 1px solid #333;
        }

        .section h3 {
            color: #f9a825;
            margin-bottom: 12px;
            font-size: 16px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        th,
        td {
            padding: 10px 8px;
            text-align: left;
            border-bottom: 1px solid #262828;
        }

        th {
            color: #f9a825;
            font-weight: 600;
        }

        td {
            color: #ddd;
        }

        .featured-tag {
            font-size: 12px;
            padding: 2px 7px;
            border-radius: 12px;
            background: rgba(249, 168, 37, 0.15);
            color: #f9a825;
        }

        .category-pill {
            font-size: 12px;
            padding: 3px 8px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #333;
        }

        @media (max-width: 900px) {
            .sections-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="dashboard-container">
        <div class="dashboard-header">
            <h2>Welcome, <%= username %> 👋</h2>
            <span>Here is a quick overview of your studio services.</span>
        </div>

        <div class="stats-grid">
            <div class="stat-card" style="cursor: pointer; border-color: #f9a825;"
                onclick="window.location.href='/admin/orders'">
                <div class="stat-label" style="color: #f9a825;">Manage Orders &rarr;</div>
                <div class="stat-value">View</div>
                <div class="section-label">Order Lifecycle</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total Products</div>
                <div class="stat-value">
                    <%= stats.totalProducts %>
                </div>
                <div class="section-label">All services</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Featured Products</div>
                <div class="stat-value">
                    <%= stats.featuredProducts %>
                </div>
                <div class="section-label">Homepage highlights</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Testimonials</div>
                <div class="stat-value">
                    <%= stats.totalTestimonials %>
                </div>
                <div class="section-label">Client feedback</div>
            </div>
        </div>

        <div class="sections-grid">
            <div class="section">
                <h3>Recent Products</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Featured</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentProducts.forEach(product=> { %>
                            <tr>
                                <td>
                                    <%= product.name %>
                                </td>
                                <td><span class="category-pill">
                                        <%= product.category %>
                                    </span></td>
                                <td>$<%= product.price %>
                                </td>
                                <td>
                                    <% if (product.featured) { %>
                                        <span class="featured-tag">⭐ Yes</span>
                                        <% } else { %>
                                            No
                                            <% } %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="section">
                <h3>Categories Overview</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% stats.categories.forEach(cat=> { %>
                            <tr>
                                <td><span class="category-pill">
                                        <%= cat._id %>
                                    </span></td>
                                <td>
                                    <%= cat.count %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>