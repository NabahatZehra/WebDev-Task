<%- include('partials/header') %>

<div class="page-header">
    <h2>⭐ Manage Testimonials</h2>
</div>

<style>
    .add-section {
        background: #1a1c1c;
        border: 2px solid #333;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 30px;
    }

    .add-section h3 {
        color: #f9a825;
        margin-bottom: 20px;
        font-size: 18px;
    }

    .add-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .form-group {
        margin-bottom: 0;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #f9a825;
        font-weight: 600;
        font-size: 14px;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 12px 15px;
        background: #0f1111;
        border: 2px solid #333;
        border-radius: 5px;
        color: white;
        font-size: 14px;
        transition: all 0.3s;
        font-family: Arial, Helvetica, sans-serif;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: #f9a825;
        outline: none;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 80px;
    }

    .btn-add-testimonial {
        background: #28a745;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.3s;
        grid-column: 1 / -1;
        margin-top: 10px;
    }

    .btn-add-testimonial:hover {
        background: #218838;
        transform: translateY(-2px);
    }

    .testimonials-list {
        display: grid;
        gap: 20px;
    }

    .testimonial-card {
        background: #1a1c1c;
        border: 2px solid #333;
        border-left: 4px solid #f9a825;
        border-radius: 10px;
        padding: 20px;
        display: flex;
        gap: 20px;
        transition: all 0.3s;
    }

    .testimonial-card:hover {
        transform: translateX(5px);
        box-shadow: 0 5px 20px rgba(249, 168, 37, 0.2);
    }

    .testimonial-image {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #f9a825;
        flex-shrink: 0;
    }

    .testimonial-content {
        flex: 1;
    }

    .testimonial-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 10px;
    }

    .testimonial-name {
        font-size: 18px;
        font-weight: 700;
        color: white;
        margin-bottom: 5px;
    }

    .testimonial-stars {
        color: #ffc107;
        font-size: 14px;
    }

    .testimonial-review {
        color: #ccc;
        line-height: 1.6;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .testimonial-meta {
        color: #888;
        font-size: 12px;
        margin-bottom: 10px;
    }

    .testimonial-actions {
        display: flex;
        gap: 10px;
    }

    .btn-delete-testimonial {
        background: #dc3545;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-delete-testimonial:hover {
        background: #c82333;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #888;
        background: #1a1c1c;
        border: 2px solid #333;
        border-radius: 10px;
    }

    .empty-state h3 {
        font-size: 24px;
        margin-bottom: 10px;
    }

    .required {
        color: #dc3545;
    }

    @media (max-width: 768px) {
        .add-form {
            grid-template-columns: 1fr;
        }

        .testimonial-card {
            flex-direction: column;
            text-align: center;
        }

        .testimonial-image {
            margin: 0 auto;
        }

        .testimonial-header {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<% if (success) { %>
    <div class="alert alert-success">
        ✓ <%= success %>
    </div>
<% } %>

<% if (error) { %>
    <div class="alert alert-error">
        ✗ <%= error %>
    </div>
<% } %>

<% if (isSuperAdmin) { %>
    <div class="add-section">
        <h3>➕ Add New Testimonial</h3>
        <form action="/admin/testimonials/add" method="POST" class="add-form">
            <div class="form-group">
                <label for="name">Customer Name <span class="required">*</span></label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required 
                    placeholder="Enter customer name"
                >
            </div>

            <div class="form-group">
                <label for="image">Image URL <span class="required">*</span></label>
                <input 
                    type="url" 
                    id="image" 
                    name="image" 
                    required 
                    placeholder="https://example.com/profile.jpg"
                >
            </div>

            <div class="form-group">
                <label for="stars">Rating</label>
                <select id="stars" name="stars">
                    <option value="★★★★★">★★★★★ (5 stars)</option>
                    <option value="★★★★☆">★★★★☆ (4 stars)</option>
                    <option value="★★★☆☆">★★★☆☆ (3 stars)</option>
                    <option value="★★☆☆☆">★★☆☆☆ (2 stars)</option>
                    <option value="★☆☆☆☆">★☆☆☆☆ (1 star)</option>
                </select>
            </div>

            <div class="form-group full-width">
                <label for="review">Review <span class="required">*</span></label>
                <textarea 
                    id="review" 
                    name="review" 
                    required
                    placeholder="Enter customer review"
                ></textarea>
            </div>

            <button type="submit" class="btn-add-testimonial">Add Testimonial</button>
        </form>
    </div>
<% } else { %>
    <div class="add-section" style="color: #aaa;">
        <h3>Read-only mode</h3>
        <p style="margin: 0;">Only Super Admin can add or delete testimonials.</p>
    </div>
<% } %>

<h3 style="color: #f9a825; margin-bottom: 20px; font-size: 20px;">All Testimonials (<%= testimonials.length %>)</h3>

<% if (testimonials.length > 0) { %>
    <div class="testimonials-list">
        <% testimonials.forEach(testimonial => { %>
            <div class="testimonial-card">
                <img src="<%= testimonial.image %>" alt="<%= testimonial.name %>" class="testimonial-image">
                <div class="testimonial-content">
                    <div class="testimonial-header">
                        <div>
                            <div class="testimonial-name"><%= testimonial.name %></div>
                            <div class="testimonial-stars"><%= testimonial.stars %></div>
                        </div>
                    </div>
                    <div class="testimonial-review">"<%= testimonial.review %>"</div>
                    <div class="testimonial-meta">
                        Added on <%= new Date(testimonial.createdAt).toLocaleDateString('en-US', { 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        }) %>
                    </div>
                    <div class="testimonial-actions">
                        <% if (isSuperAdmin) { %>
                            <form action="/admin/testimonials/delete/<%= testimonial._id %>" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this testimonial?')">
                                <button type="submit" class="btn-delete-testimonial">🗑️ Delete</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
<% } else { %>
    <div class="empty-state">
        <h3>⭐ No Testimonials Yet</h3>
        <p>Start by adding your first customer testimonial above</p>
    </div>
<% } %>

<%- include('partials/footer') %>